LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Other providers: set the verified API root and a model supporting function tools.
# direct (default) or openfang. OpenFang owns its provider credentials.
RDL_AGENT_BACKEND=direct
# Gazebo + Nav2 is the only runtime.
RDL_SIM_BACKEND=nav2
OPENFANG_URL=http://127.0.0.1:4200
OPENFANG_API_KEY=
OPENFANG_PROVIDER=default
OPENFANG_MODEL=default
